prefix_rule(pattern=["/usr/bin/bash", "-lc", "chromium --headless --no-sandbox --disable-gpu --disable-dev-shm-usage --allow-file-access-from-files --user-data-dir=/tmp/attendify-rewrite-chromium --dump-dom file:///tmp/tp-rewrite-render.html > /tmp/tp-rewrite-render-result.html"], decision="allow")
